{
  "title": "Submit Crypto Send Request",
  "slug": "submit-settlement-request",
  "method": "POST",
  "path": "/send/crypto",
  "description": "Submit a settlement request. Withdraw from your balance to a wallet address. You can set up settlement webhook to receive status update on your settlement.",
  "excerpt": "Submit a crypto send. Pay from your balance to a wallet address. You can set up crypto send webhook to receive status update on your crypto send.",
  "parameters": [],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "amount",
            "walletAddress",
            "cryptoCurrency",
            "cryptoNetwork",
            "sequenceId",
            "travelRuleInfo"
          ],
          "properties": {
            "amount": {
              "type": "integer",
              "description": "Crypto amount",
              "format": "int64"
            },
            "walletAddress": {
              "type": "string",
              "description": "Recipient wallet address"
            },
            "cryptoCurrency": {
              "type": "string",
              "description": "Recipient wallet crypto currency"
            },
            "cryptoNetwork": {
              "type": "string",
              "description": "Recipient wallet network"
            },
            "sequenceId": {
              "type": "string",
              "description": "Represents a unique id for the transaction from your end"
            },
            "travelRuleInfo": {
              "type": "object",
              "description": "travel rule info belonging to address owner",
              "required": [
                "name",
                "businessRegistrationNumber"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "businessRegistrationNumber": {
                  "type": "string"
                }
              }
            }
          }
        },
        "examples": {
          "Request Example": {
            "value": {
              "walletAddress": "TKMBToq6W21b6Q7158DvFca1MmXAxbcwD3",
              "cryptoNetwork": "TRC20",
              "cryptoCurrency": "USDT",
              "amount": 50
            }
          }
        }
      }
    }
  },
