{
  "title": "Get Wallets",
  "slug": "get-wallets",
  "method": "GET",
  "path": "/sub-wallets",
  "description": "Returns a list of all sub-wallets associated with the authenticated partner account. Each wallet includes its current available balance. Optionally, you can request linked virtual bank account details for each wallet.",
  "excerpt": "Returns a list of all sub-wallets associated with the authenticated partner account. Each wallet includes its current available balance. Optionally, you can request linked virtual bank account details for each wallet.",
  "parameters": [
    {
      "in": "query",
      "name": "withVirtualAccount\t",
      "schema": {
        "type": "boolean",
        "default": "false"
      },
      "description": "Set to true to include the linked virtual bank account details on each sub-wallet in the response.\n"
    },
    {
      "in": "query",
      "name": "pageSize",
      "schema": {
        "type": "string",
        "default": "15"
      },
      "description": "Number of transactions to return per page. Defaults to 15, maximum is 100."
    },
    {
      "in": "query",
      "name": "cursor",
      "schema": {
        "type": "string"
      },
      "description": "Opaque pagination token returned in pagination.nextCursor from the previous response. Pass this value to retrieve the next page of results."
    }
  ],
