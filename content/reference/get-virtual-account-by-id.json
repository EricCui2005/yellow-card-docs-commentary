{
  "title": "Get Virtual Account by ID",
  "slug": "get-virtual-account-by-id",
  "method": "GET",
  "path": "/virtual-accounts/{id}",
  "description": "Retrieves a specific virtual bank account by its unique identifier",
  "excerpt": "Retrieves a specific virtual bank account by its unique identifier",
  "parameters": [
    {
      "in": "path",
      "name": "id",
      "schema": {
        "type": "string"
      },
      "required": true,
      "description": "Virtual account unique identifier"
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {}
        },
        "examples": {
          "New Example": {
            "summary": "New Example",
            "value": {
              "name": "NGN Primary",
              "currency": "NGN",
              "sequenceId": "6fb07a60-a2c2-5eb6-bb4b-6a91b04962b1"
            }
          }
        }
      }
    }
  },
  "responses": {
