              },
              "currency": {
                "type": "string",
                "example": "USD",
                "description": "Account currency code"
              },
              "status": {
                "type": "string",
                "example": "ACTIVE",
                "description": "Virtual account status",
                "enum": [
                  "PENDING",
                  "ACTIVE",
                  "CLOSED",
                  "FROZEN"
                ]
              },
              "accountNumber": {
                "type": "string",
                "example": "1234567890",
                "description": "Bank account number"
              },
              "bankAddress": {
                "type": "string",
                "example": "",
                "description": "Bank address"
              },
              "swiftCode": {
                "type": "string",
                "example": "PCBBUS66XXX",
                "description": "SWIFT code (if applicable)"
              },
              "routingNumber": {
                "type": "string",
                "example": "125108405",
                "description": "Bank routing number"
              },
              "subwalletId": {
                "type": "string",
                "example": "6959f27c-9886-536b-a276-e1f4c2e632db",
                "description": "Associated sub-wallet identifier (custom wallets only)"
              },
              "accountName": {
                "type": "string",
                "example": "Primary Account Number",
                "description": "Account holder name"
              },
              "provider": {
                "type": "string",
                "example": "erebor"
              },
              "bankName": {
                "type": "string",
                "example": "Erebor Bank",
                "description": "Bank name"
              },
              "createdAt": {
                "type": "string",
                "example": "2026-02-10T10:25:36.338Z"
              },
              "updatedAt": {
                "type": "string",
                "example": "2026-02-10T10:25:36.338Z"
              }
            },
            "required": [
              "id",
              "currency",
              "status",
              "accountNumber",
              "accountName",
              "provider",
              "bankName",
              "createdAt",
              "updatedAt"
            ]
          },
          "examples": {
