{
  "title": "Refund Receive",
  "slug": "refund-collection",
  "method": "POST",
  "path": "/receive/{id}/refund",
  "description": "Refund cash collected from customer",
  "excerpt": "Refund cash received from customer",
  "parameters": [
    {
      "name": "id",
      "in": "path",
      "description": "Unique receive Identifier (id returned on Submit Receive request)",
